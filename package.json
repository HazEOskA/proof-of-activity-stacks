{
  "name": "proof-of-activity-stacks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "web:dev": "npm run dev --workspace @proof-of-activity/web",
    "web:build": "npm run build --workspace @proof-of-activity/web",
    "web:typecheck": "npm run typecheck --workspace @proof-of-activity/web",
    "validate": "npm run typecheck && npm test && npm run web:typecheck && npm run web:build"
  },
  "devDependencies": {
    "@stacks/clarinet-sdk": "3.21.1",
    "@stacks/transactions": "7.5.0",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "vitest-environment-clarinet": "3.0.2"
  }
}
